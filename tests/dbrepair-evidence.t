use strict;
use warnings;
use Test::More;
use File::Temp qw(tempdir);
use JSON::XS;
use Digest::SHA qw(sha256_hex);
use lib '.';
use Plugins::DBRepair::Evidence;
my $dir=tempdir(CLEANUP=>1);my $db="$dir/library.db";
open my $f,'>:raw',$db or die $!;print {$f} 'saved database bytes';close $f;
my $old=Plugins::DBRepair::Evidence::backupEvidence($db);
is($old->{consistency},'unproven','Missing evidence is unproven, not invalid');
sub manifest {open my $out,'>:raw',"$dir/manifest.json" or die $!;print {$out} encode_json($_[0]);close $out;}
manifest({created=>'old',files=>['library.db']});
is(Plugins::DBRepair::Evidence::backupEvidence($db)->{consistency},'unproven','Old manifest does not imply consistency');
manifest({format_version=>2,creation_context=>{lms_version=>'historic'},creation_evidence=>{service_state=>'Stopped',scanner_absence_checked=>1},file_evidence=>[{name=>'library.db',bytes=>20,sha256=>sha256_hex('saved database bytes')}]});
my $e=Plugins::DBRepair::Evidence::backupEvidence($db);
is($e->{consistency},'procedure_documented','Hash and stopped-service evidence verified');
is($e->{historical_context}{lms_version},'historic','Historical context preserved separately');
open $f,'>>:raw',$db;print {$f} 'changed';close $f;
$e=Plugins::DBRepair::Evidence::backupEvidence($db);
is($e->{consistency},'unproven','Changed bytes invalidate evidence match, not silently accepted');
ok(!$e->{current_verification}{files}[0]{matches},'Mismatch exposed');
my $damage=Plugins::DBRepair::Evidence::damage({output_complete=>0,messages=>['Main freelist: invalid page number 50','On tree page 30 cell 2: Rowid 4 out of order','row 2 missing from index idx_title'],schema_objects=>[{type=>'index',name=>'idx_title',tbl_name=>'tracks'}]});
ok($damage->{groups}{page_management},'Page errors grouped');
ok($damage->{groups}{tree_structure},'Tree errors grouped');
ok($damage->{groups}{indexes},'Index errors grouped');
is($damage->{verified_index_tables}[0]{table},'tracks','Only actual schema maps index to table');
is($damage->{page_to_table_mapping},'not_established','No guessed page-to-table mapping');
ok($damage->{incomplete},'Incomplete damage overview explicit');
my $report={mode=>'compare',output_complete=>0,server_start=>{connection=>{synchronous=>0}},checks=>[{state=>'ok',output_complete=>1,messages=>['ok'],server_start=>{connection=>{synchronous=>0}},database=>{kind=>'original'}},{state=>'error',output_complete=>0,messages=>['malformed'],error=>{category=>'corruption'},database=>{kind=>'backup',path=>$db}}]};
Plugins::DBRepair::Evidence::enrich($report);
is($report->{outcomes}{current_integrity},'intact','Healthy current database remains intact in mixed outcome');
is($report->{outcomes}{backup_integrity},'damaged','Backup damage shown independently');
is($report->{outcomes}{content_comparison},'not_possible','Content comparison separate');
like($report->{checks}[0]{synchronous_warning},qr/kein Nachweis/,'synchronous OFF not blamed on plugin conflict');
ok(!exists $report->{checks}[0]{error},'Healthy result not polluted with empty error object');
done_testing;
